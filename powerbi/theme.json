{
  "name": "Sentinel Dark",
  "dataColors": ["#31E1C4", "#4C8DFF", "#FFB547", "#FF6B6B", "#A78BFA", "#38BDF8", "#F472B6", "#84CC16"],
  "background": "#0E1628",
  "foreground": "#E6EDF7",
  "tableAccent": "#31E1C4",
  "good": "#31E1C4",
  "neutral": "#8B9BB4",
  "bad": "#FF6B6B",
  "maximum": "#31E1C4",
  "minimum": "#1B2A44",
  "textClasses": {
    "title":      { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#F2F7FF" },
    "header":     { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#C7D4E8" },
    "label":      { "fontFace": "Segoe UI", "fontSize": 9,  "color": "#9FB0C9" },
    "callout":    { "fontFace": "Segoe UI Bold", "fontSize": 30, "color": "#F2F7FF" },
    "largeTitle": { "fontFace": "Segoe UI Semibold", "fontSize": 16, "color": "#F2F7FF" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background":  [{ "show": true, "color": { "solid": { "color": "#16233C" } }, "transparency": 0 }],
        "border":      [{ "show": true, "color": { "solid": { "color": "#243553" } }, "radius": 10 }],
        "dropShadow":  [{ "show": true, "color": { "solid": { "color": "#000000" } }, "position": "Outer", "preset": "Custom", "shadowSpread": 4, "shadowBlur": 12, "transparency": 70, "angle": 90 }],
        "visualHeader":[{ "show": false }],
        "title": [{
          "show": true, "fontColor": { "solid": { "color": "#F2F7FF" } },
          "background": { "solid": { "color": "#16233C" } },
          "fontSize": 12, "fontFamily": "Segoe UI Semibold", "alignment": "left"
        }],
        "subTitle": [{ "show": false }],
        "categoryAxis": [{
          "show": true, "labelColor": { "solid": { "color": "#8FA3BF" } }, "fontSize": 9,
          "gridlineShow": false, "showAxisTitle": false
        }],
        "valueAxis": [{
          "show": true, "labelColor": { "solid": { "color": "#8FA3BF" } }, "fontSize": 9,
          "gridlineShow": true, "gridlineColor": { "solid": { "color": "#22334F" } },
          "gridlineThickness": 1, "showAxisTitle": false
        }],
        "legend": [{
          "show": true, "position": "TopLeft", "labelColor": { "solid": { "color": "#C7D4E8" } },
          "fontSize": 9, "showTitle": false
        }],
        "labels": [{ "color": { "solid": { "color": "#E6EDF7" } }, "fontSize": 9 }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#0E1628" } }, "transparency": 0 }] }
    },
    "card": {
      "*": {
        "labels":         [{ "color": { "solid": { "color": "#31E1C4" } }, "fontSize": 26, "fontFamily": "Segoe UI Bold" }],
        "categoryLabels": [{ "color": { "solid": { "color": "#9FB0C9" } }, "fontSize": 10 }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#16233C" } } }],
        "items":  [{ "fontColor": { "solid": { "color": "#C7D4E8" } }, "background": { "solid": { "color": "#16233C" } }, "fontSize": 10 }],
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#31E1C4" } }, "fontSize": 10 }]
      }
    },
    "lineChart":      { "*": { "lineStyles": [{ "strokeWidth": 2, "lineStyle": "solid" }] } },
    "textbox":        { "*": { "background": [{ "show": false }], "border": [{ "show": false }], "dropShadow": [{ "show": false }] } },
    "actionButton":   { "*": { "dropShadow": [{ "show": false }] } }
  }
}

{
  "name": "DOSM Report",
  "dataColors": ["#1F3B73", "#6E9BD8", "#C08457", "#4E6E9F", "#9FB8DE", "#7A6A58", "#2E5A8A", "#B0C4DE"],
  "background": "#F4F6FA",
  "foreground": "#5A6478",
  "tableAccent": "#1F3B73",
  "good": "#2E7D5B",
  "neutral": "#8A93A5",
  "bad": "#B4453C",
  "textClasses": {
    "title":   { "fontFace": "DIN", "fontSize": 12, "color": "#17255A" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 10, "color": "#17255A" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 9, "color": "#5A6478" },
    "callout": { "fontFace": "Segoe UI", "fontSize": 21, "color": "#1F3B73" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border":     [{ "show": true, "color": { "solid": { "color": "#E3E8F0" } }, "radius": 8 }],
        "title": [{
          "show": true, "fontColor": { "solid": { "color": "#17255A" } },
          "fontSize": 12, "fontFamily": "DIN", "alignment": "left"
        }],
        "categoryAxis": [{ "show": true, "labelColor": { "solid": { "color": "#5A6478" } }, "fontSize": 9, "gridlineShow": false, "showAxisTitle": false }],
        "valueAxis":    [{ "show": true, "labelColor": { "solid": { "color": "#5A6478" } }, "fontSize": 9, "gridlineShow": true, "gridlineColor": { "solid": { "color": "#EDF1F7" } }, "showAxisTitle": false }],
        "legend":       [{ "show": true, "position": "BottomLeft", "labelColor": { "solid": { "color": "#5A6478" } }, "fontSize": 9, "showTitle": false }]
      }
    },
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#F4F6FA" } }, "transparency": 0 }] } }
  }
}
